# Copia este archivo como .env y llena los valores reales. Nunca subas .env a Git.

PORT=8787

# deepseek | openai | anthropic
LLM_PROVIDER=
LLM_API_KEY=
# Opcionales: dejar vacío usa el default de cada proveedor.
LLM_MODEL=
LLM_BASE_URL=

# Cadena larga aleatoria; la misma que pongas en el userscript y en rule-editor.html.
SHARED_SECRET=

# Fine-grained PAT de GitHub, permiso Contents: Read and write, limitado al repo de la KB.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# "" si docs/ está en la raíz del repo de la KB; "kb" si subiste todo este proyecto.
KB_ROOT=

# Orígenes permitidos para CORS, separados por coma. "*" para cualquiera (la
# autenticación real la hace SHARED_SECRET, no CORS).
ALLOWED_ORIGINS=*
